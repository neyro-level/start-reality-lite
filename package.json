{
  "name": "start-reality-lite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "verify": "pnpm lint && pnpm test:unit && pnpm verify:layers && pnpm verify:contracts && pnpm verify:snapshot && pnpm verify:lifecycle && pnpm verify:repository && pnpm verify:seo-contracts && pnpm verify:journal && pnpm verify:ui-core && pnpm verify:routes && pnpm verify:leads && pnpm verify:media && pnpm verify:security && pnpm verify:performance && pnpm verify:exit-mode && pnpm verify:env && pnpm template:check && pnpm verify:freeze",
    "verify:freeze": "tsx scripts/verify-template-freeze.ts",
    "verify:layers": "node scripts/verify-layers.mjs && depcruise src --config .dependency-cruiser.mjs && tsx scripts/verify-grammar.ts",
    "verify:seo-contracts": "tsx scripts/verify-seo-contracts.ts",
    "verify:journal": "tsx scripts/verify-journal.ts",
    "verify:ui-core": "tsx scripts/verify-ui-core.ts",
    "verify:routes": "tsx scripts/verify-routes.ts",
    "verify:leads": "tsx scripts/verify-leads.ts",
    "verify:media": "tsx scripts/verify-media.ts",
    "verify:security": "tsx scripts/verify-security.ts",
    "verify:exit-mode": "tsx scripts/verify-exit-mode.ts",
    "verify:env": "tsx scripts/verify-env.ts",
    "verify:repository": "tsx scripts/verify-repository.ts",
    "verify:performance": "tsx scripts/verify-performance.ts",
    "template:check": "tsx scripts/template-check.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:bundle": "node scripts/bundle-worker.cjs",
    "sync:worker": "tsx scripts/worker.ts",
    "sync:worker:bundle": "node scripts/bundle-worker.cjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:contracts": "tsx scripts/verify-contracts.ts",
    "verify:snapshot": "tsx scripts/verify-snapshot.ts",
    "verify:lifecycle": "tsx scripts/verify-lifecycle.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.5.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
